/*
 * Lily58 physical key diagnostic, one layer, all 58 positions active.
 * Intended for the tsbohc/zmk-config-lily58 builder repository.
 * No layers, tap-hold, one-shot Shift, or language switching.
 * Layout order: 12 + 12 + 12 + 14 + 8.
 * The physical top-right row must produce 7 8 9 0 - = on a US layout.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        test_layer {
            display-name = "TEST";
            bindings = <
                // Physical top row: LEFT six, RIGHT six
                &kp N1      &kp N2   &kp N3   &kp N4    &kp N5   &kp N6
                &kp N7      &kp N8   &kp N9   &kp N0    &kp MINUS &kp EQUAL

                // Upper alpha row: LEFT six, RIGHT six
                &kp TAB     &kp Q    &kp W    &kp E     &kp R    &kp T
                &kp Y       &kp U    &kp I    &kp O     &kp P    &kp LBKT

                // Home row: LEFT six, RIGHT six
                &kp LCTRL   &kp A    &kp S    &kp D     &kp F    &kp G
                &kp H       &kp J    &kp K    &kp L     &kp SEMI &kp SQT

                // Lower row: LEFT seven, RIGHT seven
                &kp LSHFT   &kp Z    &kp X    &kp C     &kp V    &kp B    &kp RBKT
                &kp BSLH    &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH &kp RSHFT

                // Thumbs: LEFT four, RIGHT four
                &kp ESC     &kp LALT &kp RET  &kp SPACE
                &kp BSPC    &kp DEL  &kp HOME &kp END
            >;
        };
    };
};
