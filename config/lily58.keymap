/*
 * Lily58 / nice!nano v2 - Enthium v15 + modified Strannik - v14-derived
 * Physical order: 12+12+12+14+8 positions, per builder lily58.keymap.
 * Six user layers + two internal one-shot Shift overlay layers.
 * Important: the one-shot Shift layers are designed to survive Space taps.
 * Build from the builder's repository to keep its custom board/shield files.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

#define EN 0
#define RU 1
#define NUM 2
#define NAV 3
#define SHORT 4
#define GAME 5
#define OSE 6
#define OSR 7

/* These refer to the physical key POSITION indices, not HID codes. */
#define LHS 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53
#define RHS 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 54 55 56 57

/* Releasing on key PRESS lets the Space macro re-arm the one-shot layer.
 * The long timeout means ordinary typing does not silently lose pending Shift.
 */
&sl {
    quick-release;
    release-after-ms = <60000>;
};

/ {
    behaviors {
        hml: home_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <RHS>;
        };
        hmr: home_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <LHS>;
        };
        en_brace_lt: en_brace_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT)>, <&kp LS(COMMA)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        en_brace_gt: en_brace_gt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(RBKT)>, <&kp LS(DOT)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        en_comma_lt: en_comma_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(COMMA)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        en_period_gt: en_period_gt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp LS(DOT)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        en_slash_bs: en_slash_bs {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BSLH>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        en_amp_caret: en_amp_caret {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N7)>, <&kp LS(N6)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        en_star_pct: en_star_pct {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N8)>, <&kp LS(N5)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        en_hash_at: en_hash_at {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N3)>, <&kp LS(N2)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        en_minus_eq: en_minus_eq {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp EQUAL>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        en_lbrace_lbkt: en_lbrace_lbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT)>, <&kp LBKT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        en_rbrace_rbkt: en_rbrace_rbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(RBKT)>, <&kp RBKT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ru_brace_lt: ru_brace_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&us_lbrace>, <&us_lt>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ru_brace_gt: ru_brace_gt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&us_rbrace>, <&us_gt>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ru_comma_lt: ru_comma_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(FSLH)>, <&us_lt>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ru_period_gt: ru_period_gt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&us_gt>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ru_slash_bs: ru_slash_bs {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&us_slash>, <&us_backslash>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        ru_star_pct: ru_star_pct {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N8)>, <&kp LS(N5)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
    };
    macros {
        /* Requires exactly two Windows input languages and Alt+Shift as switch. */
        os_toggle: os_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <35>;
            bindings = <&macro_press &kp LALT &kp LSHFT>, <&macro_release &kp LSHFT &kp LALT>;
        };
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            bindings = <&os_toggle &to RU>;
        };
        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            bindings = <&os_toggle &to EN>;
        };
        /* Sticky-shift overlay has no physical Shift held: Space prints plainly,
         * then re-arms the same overlay after the Space event consumed it.
         */
        sp_base: sp_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE>;
        };
        sp_keep_en: sp_keep_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            bindings = <&kp SPACE &sl OSE>;
        };
        sp_keep_ru: sp_keep_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            bindings = <&kp SPACE &sl OSR>;
        };
        us_lbrace: us_lbrace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <35>;
            bindings = <&os_toggle &kp LS(LBKT) &os_toggle>;
        };
        us_rbrace: us_rbrace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <35>;
            bindings = <&os_toggle &kp LS(RBKT) &os_toggle>;
        };
        us_lt: us_lt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <35>;
            bindings = <&os_toggle &kp LS(COMMA) &os_toggle>;
        };
        us_gt: us_gt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <35>;
            bindings = <&os_toggle &kp LS(DOT) &os_toggle>;
        };
        us_slash: us_slash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <35>;
            bindings = <&os_toggle &kp FSLH &os_toggle>;
        };
        us_backslash: us_backslash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <35>;
            bindings = <&os_toggle &kp BSLH &os_toggle>;
        };
        us_hash: us_hash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <35>;
            bindings = <&os_toggle &kp LS(N3) &os_toggle>;
        };
        us_at: us_at {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <35>;
            bindings = <&os_toggle &kp LS(N2) &os_toggle>;
        };
        us_dollar: us_dollar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <35>;
            bindings = <&os_toggle &kp LS(N4) &os_toggle>;
        };
        us_amp: us_amp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <35>;
            bindings = <&os_toggle &kp LS(N7) &os_toggle>;
        };
        us_squote: us_squote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <35>;
            bindings = <&os_toggle &kp SQT &os_toggle>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        en_layer {
            display-name = "EN - Enthium";
            bindings = <
                &kp LS(N1)  &kp LS(FSLH)  &kp LS(SQT)  &en_brace_lt  &en_brace_gt  &kp LS(MINUS)  &kp MINUS  &en_comma_lt  &en_period_gt  &en_slash_bs  &kp EQUAL  &kp LS(EQUAL)
                &none  &kp Q  &kp Y  &kp U  &kp O  &en_amp_caret  &kp X  &kp L  &kp D  &kp P  &kp Z  &en_star_pct
                &kp B  &hml LGUI C  &hml LALT I  &hml LCTRL E  &hml LSHFT A  &lt NUM LS(BSLH)  &lt NAV K  &hmr RSHFT H  &hmr RCTRL T  &hmr RALT N  &hmr RGUI S  &kp W
                &kp LC(BSPC)  &en_hash_at  &en_minus_eq  &en_lbrace_lbkt  &en_rbrace_rbkt  &kp LS(N4)  &kp LS(SEMI)  &kp SEMI  &kp J  &kp M  &kp G  &kp F  &kp V  &kp SQT
                &lt SHORT TAB  &to_ru  &kp RET  &sp_base  &sl OSE  &kp R  &kp BSPC  &kp ESC
            >;
        };
        ru_layer {
            display-name = "RU - Strannik";
            bindings = <
                &kp LS(N1)  &kp LS(N7)  &kp LS(N2)  &ru_brace_lt  &ru_brace_gt  &kp LS(MINUS)  &kp MINUS  &ru_comma_lt  &ru_period_gt  &ru_slash_bs  &kp EQUAL  &kp LS(EQUAL)
                &none  &kp RBKT  &kp E  &kp F  &kp SEMI  &kp DOT  &kp O  &kp V  &kp P  &kp L  &kp U  &ru_star_pct
                &kp GRAVE  &hml LGUI Q  &hml LALT T  &hml LCTRL J  &hml LSHFT R  &lt NUM Z  &lt NAV K  &hmr RSHFT Y  &hmr RCTRL N  &hmr RALT C  &hmr RGUI COMMA  &kp W
                &kp LC(BSPC)  &kp M  &kp SQT  &kp S  &kp G  &kp A  &kp LS(N6)  &kp LS(N4)  &kp Q  &kp H  &kp LBKT  &kp X  &kp I  &none
                &lt SHORT TAB  &to_en  &kp RET  &sp_base  &sl OSR  &kp D  &kp BSPC  &kp ESC
            >;
        };
        num_layer {
            display-name = "NUM";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        nav_layer {
            display-name = "NAV";
            bindings = <
                &kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
                &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &kp DEL  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp INS  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &tog NAV  &kp LC(LEFT)  &kp LC(DOWN)  &kp LC(UP)  &kp LC(RIGHT)  &tog GAME  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        short_layer {
            display-name = "SHORT";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp LC(Q)  &kp LC(Y)  &kp LC(U)  &kp LC(O)  &trans  &kp LC(X)  &kp LC(L)  &kp LC(D)  &kp LC(P)  &kp LC(Z)  &trans
                &kp LC(B)  &hml LGUI LC(C)  &hml LALT LC(I)  &hml LCTRL LC(E)  &hml LSHFT LC(A)  &trans  &kp LC(K)  &hmr RSHFT LC(H)  &hmr RCTRL LC(T)  &hmr RALT LC(N)  &hmr RGUI LC(S)  &kp LC(W)
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(J)  &kp LC(M)  &kp LC(G)  &kp LC(F)  &kp LC(V)  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &kp LC(R)  &trans  &trans
            >;
        };
        game_layer {
            display-name = "GAME";
            bindings = <
                &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT
                &kp LSHFT  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
                &kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp LALT  &tog GAME  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RBKT
                &none  &none  &none  &kp SPACE  &kp RET  &kp BSPC  &none  &kp ESC
            >;
        };
        one_shot_en_layer {
            display-name = "internal OS shift EN";
            bindings = <
                &kp LS(N1)  &kp LS(FSLH)  &kp LS(SQT)  &kp LS(COMMA)  &kp LS(DOT)  &kp LS(MINUS)  &kp LS(MINUS)  &kp LS(COMMA)  &kp LS(DOT)  &kp BSLH  &kp LS(EQUAL)  &kp LS(EQUAL)
                &none  &kp LS(Q)  &kp LS(Y)  &kp LS(U)  &kp LS(O)  &kp LS(N6)  &kp LS(X)  &kp LS(L)  &kp LS(D)  &kp LS(P)  &kp LS(Z)  &kp LS(N5)
                &kp LS(B)  &hml LGUI LS(C)  &hml LALT LS(I)  &hml LCTRL LS(E)  &hml LSHFT LS(A)  &lt NUM LS(BSLH)  &lt NAV LS(K)  &hmr RSHFT LS(H)  &hmr RCTRL LS(T)  &hmr RALT LS(N)  &hmr RGUI LS(S)  &kp LS(W)
                &kp LC(BSPC)  &kp LS(N2)  &kp EQUAL  &kp LBKT  &kp RBKT  &kp LS(N4)  &kp LS(SEMI)  &kp LS(SEMI)  &kp LS(J)  &kp LS(M)  &kp LS(G)  &kp LS(F)  &kp LS(V)  &kp LS(SQT)
                &lt SHORT TAB  &to_ru  &kp RET  &sp_keep_en  &sl OSE  &kp LS(R)  &kp BSPC  &kp ESC
            >;
        };
        one_shot_ru_layer {
            display-name = "internal OS shift RU";
            bindings = <
                &kp LS(N1)  &kp LS(N7)  &kp LS(N2)  &us_lt  &us_gt  &kp LS(MINUS)  &kp LS(MINUS)  &us_lt  &us_gt  &us_backslash  &kp LS(EQUAL)  &kp LS(EQUAL)
                &none  &kp LS(RBKT)  &kp LS(E)  &kp LS(F)  &kp LS(SEMI)  &kp LS(DOT)  &kp LS(O)  &kp LS(V)  &kp LS(P)  &kp LS(L)  &kp LS(U)  &kp LS(N5)
                &kp LS(GRAVE)  &hml LGUI LS(Q)  &hml LALT LS(T)  &hml LCTRL LS(J)  &hml LSHFT LS(R)  &lt NUM LS(Z)  &lt NAV LS(K)  &hmr RSHFT LS(Y)  &hmr RCTRL LS(N)  &hmr RALT LS(C)  &hmr RGUI LS(COMMA)  &kp LS(W)
                &kp LC(BSPC)  &kp LS(M)  &kp LS(SQT)  &kp LS(S)  &kp LS(G)  &kp LS(A)  &kp LS(N6)  &kp LS(N4)  &kp LS(Q)  &kp LS(H)  &kp LS(LBKT)  &kp LS(X)  &kp LS(I)  &none
                &lt SHORT TAB  &to_en  &kp RET  &sp_keep_ru  &sl OSR  &kp LS(D)  &kp BSPC  &kp ESC
            >;
        };
    };
};
